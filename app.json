{
  "expo": {
    "name": "CJ Trucks Parts",
    "slug": "cj-trucks-parts",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.millstruckservice.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "fetch"
        ],
        "NSCameraUsageDescription": "Esta app requiere acceso a la cámara para fotos de repuestos si es necesario.",
        "NSPhotoLibraryUsageDescription": "Esta app requiere acceso a la galería para adjuntar fotos de referencias.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.millstruckservice.app",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "89163ce6-2a27-4a6d-a877-f1d85faacb5d"
      }
    },
    "owner": "bymadrigal"
  }
}
